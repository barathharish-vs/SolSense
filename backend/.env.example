# SolSense Flask & MySQL Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=solsense-secret-development-key-change-in-production
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=solsense_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
# Optional full URI override (if specified, takes precedence):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/solsense_db
